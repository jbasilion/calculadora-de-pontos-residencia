# ================================================================
#  Secrets do bot de notícias  (Telegram -> IA -> WordPress)
#  Configure no Supabase com:  supabase secrets set NOME=valor
#  NÃO comite o arquivo .env real com valores preenchidos.
# ================================================================

# --- Telegram ---
# Token do bot criado no @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Segredo aleatório usado na URL do webhook (invente um valor longo)
TELEGRAM_WEBHOOK_SECRET=um-segredo-bem-grande-aleatorio
# (Opcional, recomendado) Só aceita mensagens deste chat. Descubra o seu id
# enviando /start ao @userinfobot no Telegram.
TELEGRAM_ALLOWED_CHAT_ID=123456789

# --- IA (grátis: Google Gemini) ---
AI_PROVIDER=gemini
# Crie a chave em https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash
# (Só se AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- WordPress ---
# URL base do site, sem barra no fim
WP_BASE_URL=https://seusite.com.br
# Usuário do WordPress
WP_USER=seu_usuario
# Application Password (Usuários -> Perfil -> Application Passwords)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# draft = salva como rascunho para revisão | publish = publica direto
WP_DEFAULT_STATUS=draft
# (Opcional) id numérico da categoria onde publicar
# WP_CATEGORY_ID=5

# --- Aparência ---
SITE_NAME=Seu Portal
# Bucket do Storage onde as fotos originais são guardadas
STORAGE_BUCKET=news-photos
