# ---- IA ----
# gemini (padrão, tem plano gratuito) ou anthropic
LLM_PROVIDER=gemini

# Gemini: chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# gemini-2.5-flash (10 req/min, 250/dia no plano grátis) ou gemini-2.5-flash-lite (15 req/min, 1000/dia)
GEMINI_MODEL=gemini-2.5-flash
# Opcional: 0 desliga o "pensamento" do modelo (respostas mais rápidas); -1 = automático
# GEMINI_THINKING_BUDGET=0

# Claude (só se LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# ---- Telegram ----
# Token do bot: fale com @BotFather no Telegram, /newbot, e copie o token
TELEGRAM_BOT_TOKEN=123456789:AAH...
# polling (padrão: não precisa de URL pública) ou webhook
TELEGRAM_MODE=polling
# Só para TELEGRAM_MODE=webhook: URL pública HTTPS do servidor e um segredo à sua escolha
# TELEGRAM_WEBHOOK_URL=https://seu-app.exemplo.com
# TELEGRAM_WEBHOOK_SECRET=uma-frase-secreta

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # chave service_role (só no servidor!)

# ---- Geral ----
PORT=3000
DEFAULT_TIMEZONE=America/Sao_Paulo
# Opcional: só estes ids de usuário/chat do Telegram podem usar o bot (separados por vírgula).
# Descubra o seu mandando qualquer mensagem: o bot responde com o id quando a lista está preenchida.
ALLOWED_CHAT_IDS=
