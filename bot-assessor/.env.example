# ---- IA ----
# gemini (padrão, tem plano gratuito) ou anthropic
LLM_PROVIDER=gemini

# Gemini: chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# gemini-2.5-flash (10 req/min, 250/dia no plano grátis) ou gemini-2.5-flash-lite (15 req/min, 1000/dia)
GEMINI_MODEL=gemini-2.5-flash
# Opcional: 0 desliga o "pensamento" do modelo (respostas mais rápidas); -1 = automático
# GEMINI_THINKING_BUDGET=0

# Claude (só se LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# ---- WhatsApp Cloud API (Meta for Developers) ----
WHATSAPP_TOKEN=EAAG...                 # token permanente do System User
WHATSAPP_PHONE_NUMBER_ID=1234567890    # ID do número de telefone (não é o número em si)
WHATSAPP_VERIFY_TOKEN=uma-frase-secreta-sua   # você escolhe; usada na verificação do webhook
WHATSAPP_APP_SECRET=abc123...          # App Secret do app da Meta (valida a assinatura do webhook)
WHATSAPP_API_VERSION=v21.0

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # chave service_role (só no servidor!)

# ---- Geral ----
PORT=3000
DEFAULT_TIMEZONE=America/Sao_Paulo
# Opcional: só estes números podem usar o bot (separados por vírgula, com DDI, ex.: 5511999999999)
ALLOWED_PHONES=
