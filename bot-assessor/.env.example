# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...
# Modelo padrão. Troque só se quiser (ex.: claude-sonnet-5 para custo menor).
ASSESSOR_MODEL=claude-opus-5
# Profundidade de raciocínio: low | medium | high
ASSESSOR_EFFORT=medium

# ---- WhatsApp Cloud API (Meta for Developers) ----
WHATSAPP_TOKEN=EAAG...                 # token permanente do System User
WHATSAPP_PHONE_NUMBER_ID=1234567890    # ID do número de telefone (não é o número em si)
WHATSAPP_VERIFY_TOKEN=uma-frase-secreta-sua   # você escolhe; usada na verificação do webhook
WHATSAPP_APP_SECRET=abc123...          # App Secret do app da Meta (valida a assinatura do webhook)
WHATSAPP_API_VERSION=v21.0

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # chave service_role (só no servidor!)

# ---- Geral ----
PORT=3000
DEFAULT_TIMEZONE=America/Sao_Paulo
# Opcional: só estes números podem usar o bot (separados por vírgula, com DDI, ex.: 5511999999999)
ALLOWED_PHONES=
